{
  "name": "codega-mail",
  "version": "1.25.0",
  "description": "CODEGA Mail - Yerel masaüstü mail istemcisi (IMAP/POP3, sistem tepsisi, otomatik güncelleme, ek dosya, birleşik gelen kutusu, zengin metin editörü)",
  "main": "src/main.js",
  "author": "CODEGA",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "release:win": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.3.0",
    "imap": "^0.8.19",
    "mailparser": "^3.6.5",
    "node-notifier": "^10.0.1",
    "node-pop3": "^0.10.0",
    "nodemailer": "^6.9.7",
    "openpgp": "^5.11.2",
    "qrcode": "^1.5.4",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "tr.com.codega.mail",
    "productName": "CODEGA Mail",
    "directories": {
      "output": "dist",
      "buildResources": "src/ui"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "src/ui/icon.png",
      "src/ui/icon.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "codegatr",
        "repo": "codegamailapp",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "src/ui/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CODEGA Mail",
      "uninstallDisplayName": "CODEGA Mail"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "src/ui/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
